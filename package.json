{
  "name": "games-choice",
  "version": "0.1.0",
  "private": true,
  "description": "선택의 연속 - 오프라인 성향 추리 비주얼노벨 + 숏폼 미니게임 프로토타입",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "npm run build && node scripts/inline-build.mjs",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/core": "6.2.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.0",
    "@types/three": "^0.160.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
